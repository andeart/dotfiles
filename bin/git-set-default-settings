#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: git-set-default-settings [--dry-run] [--assignee <user>] [<path>]

Apply a curated set of local settings to a git repository. Each setting is
confirmed individually and every prompt defaults to No. <path> defaults to the
current directory. Re-runs are idempotent.

Settings:
  gitleaks secret scanning   Two pre-commit hooks: the published gitleaks hook
                             scans the staged diff on every commit, and a
                             gitleaks-history hook scans the commits a push
                             introduces.
  Dependabot pre-commit      Declares the pre-commit ecosystem in
                             .github/dependabot.yml so the pinned hook above
                             keeps getting version bumps.

Requires: git, yq, pre-commit. gh is optional (used to pick a Dependabot
assignee).

Options:
  -n, --dry-run          Preview what would change without making any changes
                         or prompting.
  -a, --assignee <user>  GitHub username to assign Dependabot pull requests to.
                         Defaults to the authenticated gh user.
  -h, --help             Show this help.
EOF
}

# ---------------------------------------------------------------------------
# Setting definitions
#
# Each setting is a trio of functions sharing a <name>_ prefix:
#   <name>_label            human label used in the confirmation prompt
#   <name>_plan  <repo>     read-only; prints one "ok:"/"change:"/"blocked:"
#                           line per sub-change
#   <name>_apply <repo>     performs the changes
#
# To add a setting, define the trio and register its prefix in SETTINGS below.
# The driver treats a plan with no "change:" line as already satisfied, and any
# "blocked:" line as a refusal to apply.
# ---------------------------------------------------------------------------

PRECOMMIT_CONFIG=".pre-commit-config.yaml"
DEPENDABOT_CONFIG=".github/dependabot.yml"

GITLEAKS_HOOK_REPO="https://github.com/gitleaks/gitleaks"
# Floor version only. Dependabot's pre-commit ecosystem (installed by the
# dependabot_precommit setting) bumps this in the target repo from here on.
GITLEAKS_HOOK_REV="v8.30.1"

# The push-time tier is a local hook rather than a second use of the published
# one because all three published hooks bake "--staged" into `entry`, and `entry`
# is not overridable from a consumer config - `args` only appends. A published
# hook at pre-push would scan the (empty) staged diff and pass.
#
# Range: everything on HEAD that no remote has yet. With no remotes nothing is
# subtracted, so it degrades to a full scan. "origin/HEAD..HEAD" is deliberately
# avoided - where origin/HEAD is unset (any repo built with `git remote add`
# rather than `git clone`) it exits 0 having scanned nothing, which reads as a
# pass.
GITLEAKS_HISTORY_ENTRY='gitleaks git --redact --no-banner --log-opts "HEAD --not --remotes"'

# Marker pre-commit writes into every hook it generates.
PRECOMMIT_MARKER="File generated by pre-commit"

die() {
  echo "Error: $*" >&2
  exit 1
}

reply_is_yes() {
  local reply="${1:-}"
  reply="$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')"
  [[ "$reply" == "y" || "$reply" == "yes" ]]
}

# Prompt on the tty (so it works even when stdin is otherwise occupied) and
# return whether the answer is yes. Defaults to No.
confirm() {
  local label="$1" reply
  printf 'Apply %s? [y/N] ' "$label" > /dev/tty
  read -r reply < /dev/tty || reply=""
  reply_is_yes "$reply"
}

# repo_root <path>: print the working-tree root of the repo containing <path>.
repo_root() {
  local path="$1" root
  root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" \
    || die "not a git repository: $path"
  printf '%s\n' "$root"
}

# plan_has <plan> <prefix>: whether any plan line carries that prefix.
plan_has() {
  grep -q "^$2:" <<<"$1"
}

# yaml_has_hook <file> <repo> <hook-id>: "true" if the hook is registered under
# that repo entry, "false" otherwise (including when the file is absent).
yaml_has_hook() {
  local file="$1"
  [[ -f "$file" ]] || { echo false; return 0; }
  R="$2" ID="$3" yq \
    '[.repos[]? | select(.repo == strenv(R)) | .hooks[]? | select(.id == strenv(ID))] | length > 0' \
    "$file" 2>/dev/null || echo false
}

# hook_state <repo> <hook-type>: "pre-commit", "foreign", or "absent".
hook_state() {
  local file="$1/.git/hooks/$2"
  if [[ ! -f "$file" ]]; then
    echo absent
  elif grep -qF "$PRECOMMIT_MARKER" "$file"; then
    echo pre-commit
  else
    echo foreign
  fi
}

gitleaks_precommit_label() { echo "gitleaks secret scanning"; }

gitleaks_precommit_plan() {
  local repo="$1" config="$1/$PRECOMMIT_CONFIG" type state

  if [[ "$(yaml_has_hook "$config" "$GITLEAKS_HOOK_REPO" gitleaks)" == "true" ]]; then
    echo "ok:      $PRECOMMIT_CONFIG has the pinned gitleaks hook (staged, every commit)"
  else
    echo "change:  add the pinned gitleaks hook ($GITLEAKS_HOOK_REV, staged, every commit) to $PRECOMMIT_CONFIG"
  fi

  if [[ "$(yaml_has_hook "$config" local gitleaks-history)" == "true" ]]; then
    echo "ok:      $PRECOMMIT_CONFIG has the gitleaks-history hook (unpushed commits, pre-push)"
  else
    echo "change:  add the gitleaks-history hook (unpushed commits, pre-push) to $PRECOMMIT_CONFIG"
  fi

  for type in pre-commit pre-push; do
    state="$(hook_state "$repo" "$type")"
    case "$state" in
      pre-commit) echo "ok:      .git/hooks/$type is installed by pre-commit" ;;
      absent)     echo "change:  install the $type hook" ;;
      foreign)    echo "blocked: .git/hooks/$type already exists and was not written by pre-commit - move it aside first" ;;
    esac
  done
}

gitleaks_precommit_apply() {
  local repo="$1" config="$1/$PRECOMMIT_CONFIG"

  [[ -f "$config" ]] || printf 'repos: []\n' > "$config"

  if [[ "$(yaml_has_hook "$config" "$GITLEAKS_HOOK_REPO" gitleaks)" != "true" ]]; then
    R="$GITLEAKS_HOOK_REPO" REV="$GITLEAKS_HOOK_REV" yq -i \
      '.repos += [{"repo": strenv(R), "rev": strenv(REV), "hooks": [{"id": "gitleaks"}]}]' \
      "$config"
  fi

  if [[ "$(yaml_has_hook "$config" local gitleaks-history)" != "true" ]]; then
    ENTRY="$GITLEAKS_HISTORY_ENTRY" yq -i \
      '.repos += [{"repo": "local", "hooks": [{
         "id": "gitleaks-history",
         "name": "gitleaks (history)",
         "entry": strenv(ENTRY),
         "language": "system",
         "pass_filenames": false,
         "always_run": true,
         "stages": ["pre-push"]
       }]}]' "$config"
  fi

  local type
  for type in pre-commit pre-push; do
    [[ "$(hook_state "$repo" "$type")" == "pre-commit" ]] && continue
    (cd "$repo" && pre-commit install --hook-type "$type") >/dev/null \
      || die "failed to install the $type hook in $repo"
  done
}

# yaml_has_ecosystem <file> <ecosystem>: "true" if dependabot.yml already
# declares that package-ecosystem, "false" otherwise (or when absent).
yaml_has_ecosystem() {
  local file="$1"
  [[ -f "$file" ]] || { echo false; return 0; }
  E="$2" yq '[.updates[]? | select(.["package-ecosystem"] == strenv(E))] | length > 0' \
    "$file" 2>/dev/null || echo false
}

# resolve_assignee: the GitHub login to assign Dependabot PRs to. Dependabot has
# no dynamic actor reference - assignees must be literal logins - so it is
# resolved here, at bootstrap time, rather than left to Dependabot.
resolve_assignee() {
  command -v gh >/dev/null 2>&1 || return 0
  gh api user --jq .login 2>/dev/null || true
}

dependabot_precommit_label() { echo "Dependabot updates for pre-commit hooks"; }

dependabot_precommit_plan() {
  local config="$1/$DEPENDABOT_CONFIG"

  if [[ "$(yaml_has_ecosystem "$config" pre-commit)" == "true" ]]; then
    echo "ok:      $DEPENDABOT_CONFIG declares the pre-commit ecosystem"
  else
    echo "change:  declare the pre-commit ecosystem in $DEPENDABOT_CONFIG (weekly)"
    if [[ -n "${ASSIGNEE:-}" ]]; then
      echo "change:  assign those pull requests to ${ASSIGNEE}"
    else
      echo "ok:      no assignee known - pull requests will be left unassigned"
    fi
  fi
}

dependabot_precommit_apply() {
  local repo="$1" config="$1/$DEPENDABOT_CONFIG"

  [[ "$(yaml_has_ecosystem "$config" pre-commit)" == "true" ]] && return 0

  mkdir -p "$(dirname "$config")"
  [[ -f "$config" ]] || printf 'version: 2\nupdates: []\n' > "$config"

  if [[ -n "${ASSIGNEE:-}" ]]; then
    A="$ASSIGNEE" yq -i '.updates += [{
      "package-ecosystem": "pre-commit",
      "directory": "/",
      "schedule": {"interval": "weekly"},
      "assignees": [strenv(A)]
    }]' "$config"
  else
    yq -i '.updates += [{
      "package-ecosystem": "pre-commit",
      "directory": "/",
      "schedule": {"interval": "weekly"}
    }]' "$config"
  fi
}

# Registry of settings to offer, in order.
SETTINGS=(
  gitleaks_precommit
  dependabot_precommit
)

# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------

run_setting() {
  local name="$1" plan
  plan="$("${name}_plan" "$REPO")"

  echo
  echo "$("${name}_label"):"
  printf '%s\n' "$plan" | sed 's/^/  /'

  if plan_has "$plan" blocked; then
    echo "  skipped: clear the blocked item above first."
    return 0
  fi

  if ! plan_has "$plan" change; then
    echo "  nothing to do."
    return 0
  fi

  if [[ -n "$DRY_RUN" ]]; then
    return 0
  fi

  if confirm "$("${name}_label")"; then
    "${name}_apply" "$REPO"
    echo "  applied."
  else
    echo "  skipped."
  fi
}

main() {
  DRY_RUN=""
  ASSIGNEE=""
  local path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)     usage; exit 0 ;;
      -n|--dry-run)  DRY_RUN=1; shift ;;
      -a|--assignee) [[ $# -ge 2 ]] || { usage >&2; exit 1; }; ASSIGNEE="$2"; shift 2 ;;
      -*)            usage >&2; exit 1 ;;
      *)             [[ -z "$path" ]] || { usage >&2; exit 1; }; path="$1"; shift ;;
    esac
  done

  [[ -n "$path" ]] || path="."

  local tool
  for tool in git yq pre-commit; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool not found on PATH."
  done

  REPO="$(repo_root "$path")"
  [[ -n "$ASSIGNEE" ]] || ASSIGNEE="$(resolve_assignee)"

  if [[ -n "$DRY_RUN" ]]; then
    echo "Dry run for ${REPO} (no changes will be made)..."
  else
    echo "Configuring ${REPO}..."
  fi

  local setting
  for setting in "${SETTINGS[@]}"; do
    run_setting "$setting"
  done

  echo
  echo "Done."
}

# Sourced with _GIT_SETTINGS_LIB_ONLY=1 (by tests): define functions and stop
# before parsing args or touching the filesystem.
if [[ -n "${_GIT_SETTINGS_LIB_ONLY:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
