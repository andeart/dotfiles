#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: claude-format-settings [--check] [PATH ...]

Format Claude Code settings JSON files in place:
  - permissions.allow, permissions.deny, permissions.ask sorted case-insensitively
  - enabledPlugins keys sorted case-insensitively
  - exact duplicate entries removed (reported per file)

Each PATH may be either:
  - a JSON file, formatted directly; or
  - a directory, in which case .claude/settings.json and
    .claude/settings.local.json under it are used, skipping whichever is absent
    (e.g. `claude-format-settings .` formats both files under ./.claude).

With no PATH, the current directory is used.

Options:
  --check     Do not modify files. Exit 1 if any file would be reformatted.
  -h, --help  Show this help.

No globbing. Only the given paths, or the current directory by default, are read.
EOF
}

CHECK=0
PATHS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --check) CHECK=1; shift ;;
    --) shift; while [[ $# -gt 0 ]]; do PATHS+=("$1"); shift; done ;;
    -*) printf 'Error: unknown option %q\n' "$1" >&2; usage >&2; exit 2 ;;
    *) PATHS+=("$1"); shift ;;
  esac
done

if [[ ${#PATHS[@]} -eq 0 ]]; then
  PATHS=(".")
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required but not installed" >&2
  exit 1
fi

JQ_FORMAT='
def sort_ci: sort_by(ascii_downcase);
def fmt_arr: unique | sort_ci;
def fmt_obj: to_entries | sort_by(.key | ascii_downcase) | from_entries;

(if (.permissions.allow // null) != null then .permissions.allow |= fmt_arr else . end)
| (if (.permissions.deny  // null) != null then .permissions.deny  |= fmt_arr else . end)
| (if (.permissions.ask   // null) != null then .permissions.ask   |= fmt_arr else . end)
| (if (.enabledPlugins    // null) != null then .enabledPlugins    |= fmt_obj else . end)
'

JQ_DUPES='
def dupes_in:
  reduce .[] as $x ({}; .[$x | tojson] = (.[$x | tojson] // 0) + 1)
  | to_entries | map(select(.value > 1) | .key | fromjson) | sort;

{
  allow: (.permissions.allow // [] | dupes_in),
  deny:  (.permissions.deny  // [] | dupes_in),
  ask:   (.permissions.ask   // [] | dupes_in)
}
'

EXIT=0

# A directory argument resolves to the settings files under <dir>/.claude,
# skipping whichever is absent. Anything else is taken as a file path verbatim.
TARGETS=()
for raw in "${PATHS[@]}"; do
  if [[ -d "$raw" ]]; then
    found=0
    for name in settings.json settings.local.json; do
      candidate="${raw%/}/.claude/$name"
      if [[ -e "$candidate" ]]; then
        TARGETS+=("$candidate")
        found=1
      fi
    done
    if [[ $found -eq 0 ]]; then
      echo "Error: no .claude/settings.json or .claude/settings.local.json found under directory '$raw'" >&2
      EXIT=1
    fi
  else
    TARGETS+=("$raw")
  fi
done

# Guard the expansion below: under `set -u`, bash 3.2 errors on "${arr[@]}"
# when arr is empty.
if [[ ${#TARGETS[@]} -eq 0 ]]; then
  exit $EXIT
fi

for path in "${TARGETS[@]}"; do
  if [[ ! -e "$path" ]]; then
    echo "Error: '$path' does not exist" >&2
    EXIT=1
    continue
  fi
  if [[ ! -f "$path" ]]; then
    echo "Error: '$path' is not a regular file" >&2
    EXIT=1
    continue
  fi
  if [[ ! -r "$path" ]]; then
    echo "Error: '$path' is not readable" >&2
    EXIT=1
    continue
  fi
  if [[ ! -s "$path" ]]; then
    echo "Error: '$path' is empty" >&2
    EXIT=1
    continue
  fi

  if ! tmp=$(mktemp); then
    echo "Error: failed to create temporary file for '$path'" >&2
    EXIT=1
    continue
  fi
  if ! err=$(mktemp); then
    echo "Error: failed to create temporary file for '$path'" >&2
    rm -f "$tmp"
    EXIT=1
    continue
  fi

  if ! jq "$JQ_FORMAT" "$path" > "$tmp" 2>"$err"; then
    echo "Error: failed to parse '$path' as JSON:" >&2
    cat "$err" >&2
    rm -f "$tmp" "$err"
    EXIT=1
    continue
  fi
  rm -f "$err"

  dupes_json=$(jq "$JQ_DUPES" "$path")
  for kind in allow deny ask; do
    count=$(jq ".$kind | length" <<<"$dupes_json")
    if [[ "$count" -gt 0 ]]; then
      echo "[$path] duplicate permissions.$kind entries:"
      while IFS= read -r entry; do
        printf '  %s\n' "$entry"
      done < <(jq -r ".$kind[]" <<<"$dupes_json")
    fi
  done

  if cmp -s "$path" "$tmp"; then
    [[ $CHECK -eq 0 ]] && echo "[$path] already formatted"
    rm -f "$tmp"
    continue
  fi

  if [[ $CHECK -eq 1 ]]; then
    echo "[$path] needs formatting" >&2
    rm -f "$tmp"
    EXIT=1
  elif [[ ! -w "$path" ]]; then
    echo "[$path] needs formatting but file is not writable" >&2
    rm -f "$tmp"
    EXIT=1
  else
    cat "$tmp" > "$path"
    rm -f "$tmp"
    echo "[$path] formatted"
  fi
done

exit $EXIT
