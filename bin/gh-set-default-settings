#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: gh-set-default-settings [--dry-run] <repo>

Apply a curated set of branch rulesets and repo-level settings to a GitHub
repository via the gh CLI. Each ruleset is confirmed individually, the repo
settings are confirmed as a group, and each Dependabot setting and the Plane
autolink are confirmed on their own; every prompt defaults to No.

<repo> may be any of:
  git@github.com:owner/repo.git
  https://github.com/owner/repo.git
  ssh://git@github.com/owner/repo
  owner/repo

Rulesets are idempotent: a ruleset whose name already exists is updated in place
(PUT); otherwise it is created (POST). Repo settings are set with PATCH and are
idempotent by nature. Dependabot settings already enabled are reported and left
alone rather than prompted for.

The Plane autolink is offered only when the current directory is a checkout of
<repo> and its .plane.yml supplies both `project` and `workspace`. It makes a
bare identifier in a commit message (DX-49) link to the work item. GitHub does
not apply autolinks to pull request or issue titles.

Requires: gh (authenticated), jq.

Options:
  -n, --dry-run  Preview what would change against the repo's current state
                 without making any changes or prompting.
  -h, --help     Show this help.
EOF
}

# ---------------------------------------------------------------------------
# Ruleset definitions
#
# Each ruleset is a function that prints its JSON body (the request payload for
# POST/PUT /repos/{owner}/{repo}/rulesets) to stdout. To add another ruleset,
# define a new ruleset_* function and register its name in the RULESETS array
# below. The "name" field is the idempotency key.
#
# Branch is targeted via the special "~DEFAULT_BRANCH" ref selector so the repo
# default branch is resolved by GitHub at evaluation time.
# ---------------------------------------------------------------------------

ruleset_default_baseline_guard() {
  cat <<'JSON'
{
  "name": "default baseline guard",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "creation" },
    { "type": "deletion" },
    { "type": "required_signatures" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    }
  ]
}
JSON
}

ruleset_default_pr_approval_guard() {
  # Enforcement is "disabled": both the update rule and the bypass-gated
  # approval requirement block GitHub's auto-merge, which never evaluates
  # bypass_actors on its deferred completion path. Flip to "active" only on
  # repos that do not rely on auto-merge.
  #
  # bypass_actors: actor_type "RepositoryRole" with actor_id 5 is the built-in
  # Repository admin role (built-in repository role IDs: read=1, triage=2,
  # write=3, maintain=4, admin=5).
  cat <<'JSON'
{
  "name": "default PR approval guard",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "update" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    }
  ]
}
JSON
}

# Registry of rulesets to apply, in order.
RULESETS=(
  ruleset_default_baseline_guard
  ruleset_default_pr_approval_guard
)

# Repo-level settings to enable, as "field|human label". All are set to true.
# "Auto-close issues with merged linked pull requests" is intentionally absent:
# it has no REST or GraphQL API and is enabled by default (see the note printed
# by run_repo_settings_section).
REPO_SETTINGS=(
  "allow_auto_merge|Allow auto-merge"
  "allow_update_branch|Always suggest updating pull request branches"
  "delete_branch_on_merge|Automatically delete head branches"
)

# Repo-level settings to enable under the nested security_and_analysis object,
# as "field|human label". These are not flat booleans: they read back at
# .security_and_analysis.<field>.status and are set to "enabled" rather than
# true, so they are diffed and applied separately from REPO_SETTINGS.
#
# Order matters. Push protection and non-provider patterns both build on secret
# scanning, so secret_scanning has to be enabled first.
#
# Entries are not uniformly available: see security_setting_skip_reason.
SECURITY_SETTINGS=(
  "secret_scanning|Secret scanning"
  "secret_scanning_push_protection|Push protection for secret scanning"
  "secret_scanning_non_provider_patterns|Non-provider secret scanning patterns"
)

# Dependabot settings to offer, as "endpoint|human label", where endpoint is the
# path segment under /repos/{owner}/{repo}. Neither is a field on the repo PATCH
# body, so they cannot be entries in REPO_SETTINGS or SECURITY_SETTINGS: each is
# its own sub-resource enabled by a PUT that carries no body, and each reports
# its current state differently. Each also gets its own confirmation, because
# security updates open pull requests unprompted - a larger change than alerts,
# which only report.
#
# Deliberately not behind security_settings_available: that gate exists because
# secret scanning on a private repo needs a paid plan, while both Dependabot
# settings are free on private repos.
#
# Order matters. Security updates act on what alerts surface, so alerts go first.
DEPENDABOT_SETTINGS=(
  "vulnerability-alerts|Dependabot alerts"
  "automated-security-fixes|Dependabot security updates"
)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  echo "Error: $*" >&2
  exit 1
}

reply_is_yes() {
  local reply="${1:-}"
  reply="$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')"
  [[ "$reply" == "y" || "$reply" == "yes" ]]
}

# Prompt on the tty (so it works even when stdin is otherwise occupied) and
# return whether the answer is yes. Defaults to No.
confirm() {
  local label="$1" reply
  printf 'Apply %s? [y/N] ' "$label" > /dev/tty
  read -r reply < /dev/tty || reply=""
  reply_is_yes "$reply"
}

_rule_label() {
  case "$1" in
    creation)            echo "restrict creations" ;;
    deletion)            echo "restrict deletions" ;;
    update)              echo "restrict updates" ;;
    required_signatures) echo "require signed commits" ;;
    non_fast_forward)    echo "block force pushes" ;;
    pull_request)        echo "require pull request before merging" ;;
    *)                   echo "$1" ;;
  esac
}

_pr_param_label() {
  case "$1" in
    required_approving_review_count)    echo "required approvals" ;;
    dismiss_stale_reviews_on_push)      echo "dismiss stale approvals on push" ;;
    require_code_owner_review)          echo "require code owner review" ;;
    require_last_push_approval)         echo "require last push approval" ;;
    required_review_thread_resolution)  echo "require conversation resolution" ;;
    allowed_merge_methods)              echo "allowed merge methods" ;;
    *)                                  echo "$1" ;;
  esac
}

# render_ruleset <json>: print a human-readable summary of a ruleset body.
render_ruleset() {
  local body="$1" name enforcement target n i type key val a_type a_id a_mode

  name="$(jq -r '.name' <<<"$body")"
  enforcement="$(jq -r '.enforcement' <<<"$body")"
  if jq -e '(.conditions.ref_name.include // []) | index("~DEFAULT_BRANCH")' <<<"$body" >/dev/null; then
    target="default branch"
  else
    target="$(jq -r '(.conditions.ref_name.include // []) | join(", ")' <<<"$body")"
  fi

  echo "Ruleset: $name"
  echo "  target:      $target"
  echo "  enforcement: $enforcement"

  if jq -e '(.bypass_actors // []) | length > 0' <<<"$body" >/dev/null; then
    echo "  bypass:"
    while IFS=$'\t' read -r a_type a_id a_mode; do
      echo "    - ${a_type} id ${a_id} (${a_mode})"
    done < <(jq -r '.bypass_actors[] | [.actor_type, (.actor_id|tostring), .bypass_mode] | @tsv' <<<"$body")
  fi

  echo "  rules:"
  n="$(jq '.rules | length' <<<"$body")"
  for ((i = 0; i < n; i++)); do
    type="$(jq -r ".rules[$i].type" <<<"$body")"
    echo "    - $(_rule_label "$type")"
    if [[ "$type" == "pull_request" ]]; then
      while IFS=$'\t' read -r key val; do
        echo "        $(_pr_param_label "$key"): $val"
      done < <(
        jq -r "(.rules[$i].parameters // {}) | to_entries[]
               | [.key, (.value | if type==\"array\" then join(\",\") else tostring end)]
               | @tsv" <<<"$body"
      )
    fi
  done
}

parse_repo() {
  # Normalize any supported repo reference to "owner/repo".
  local slug="$1"
  slug="${slug%.git}"     # drop trailing .git
  slug="${slug#*://}"     # drop ssh:// https:// http:// scheme
  slug="${slug#*@}"       # drop git@host / user@host
  slug="${slug/://}"      # scp-style host:owner/repo -> host/owner/repo

  local owner repo
  owner="$(printf '%s\n' "$slug" | awk -F/ '{print $(NF-1)}')"
  repo="$(printf '%s\n' "$slug" | awk -F/ '{print $NF}')"

  [[ -n "$owner" && -n "$repo" ]] || die "could not parse owner/repo from '$1'"
  printf '%s/%s\n' "$owner" "$repo"
}

# ruleset_change_kind <name> <existing_rulesets_json>: "create" or "update <id>".
ruleset_change_kind() {
  local name="$1" existing="$2" id
  id="$(jq -r --arg n "$name" 'map(select(.name == $n)) | first | .id // empty' <<<"$existing")"
  if [[ -n "$id" ]]; then
    echo "update $id"
  else
    echo "create"
  fi
}

# apply_ruleset_body <json> <existing_rulesets_json>: PUT if the name exists,
# otherwise POST. Idempotent on the ruleset name.
apply_ruleset_body() {
  local body="$1" existing="$2" name kind id
  name="$(jq -r '.name' <<<"$body")"
  kind="$(ruleset_change_kind "$name" "$existing")"
  if [[ "$kind" == update\ * ]]; then
    id="${kind#update }"
    echo "  Updating ruleset '$name' (id $id)"
    printf '%s' "$body" \
      | gh api --method PUT "/repos/${OWNER_REPO}/rulesets/${id}" --input - >/dev/null \
      || die "failed to apply ruleset '$name' to ${OWNER_REPO} (need admin access)."
  else
    echo "  Creating ruleset '$name'"
    printf '%s' "$body" \
      | gh api --method POST "/repos/${OWNER_REPO}/rulesets" --input - >/dev/null \
      || die "failed to apply ruleset '$name' to ${OWNER_REPO} (need admin access)."
  fi
}

run_rulesets_section() {
  echo "Rulesets:"
  local existing def body name kind id
  existing="$(gh api --paginate "/repos/${OWNER_REPO}/rulesets")" \
    || die "failed to list rulesets for ${OWNER_REPO} (check the repo exists and gh is authenticated with admin access)."

  for def in "${RULESETS[@]}"; do
    body="$("$def")"
    name="$(jq -r '.name' <<<"$body")"

    if [[ -n "$DRY_RUN" ]]; then
      kind="$(ruleset_change_kind "$name" "$existing")"
      if [[ "$kind" == update\ * ]]; then
        id="${kind#update }"
        echo "  ${name}: would update (exists, id ${id} - curated definition replaces it)"
      else
        echo "  ${name}: would create (not present)"
      fi
      continue
    fi

    echo
    render_ruleset "$body"
    if confirm "this ruleset"; then
      apply_ruleset_body "$body" "$existing"
    else
      echo "  skipped."
    fi
  done

  # Status-check rules are omitted from the curated rulesets on purpose: the
  # required checks (the "context" array) name checks specific to each repo,
  # which a repo-agnostic default cannot know, and the array cannot be empty.
  echo
  echo '  Note: "Require status checks to pass" and "Require branches to be up to date'
  echo '  before merging" are not in the curated rulesets, since the required checks'
  echo '  name checks specific to each repo. Add them in Settings > Rules if the repo'
  echo '  runs CI checks.'
}

# security_settings_available <current_repo_json>: whether SECURITY_SETTINGS can
# be applied to this repo. Secret scanning runs free on public repos; private
# repos need a GitHub Secret Protection plan, and where there is none the API
# returns security_and_analysis as null and rejects the PATCH. Gating on
# visibility keeps a private-repo bootstrap from failing on a setting that was
# never available to it. Repos on a plan that does cover private secret
# scanning are skipped too - enable those two in Settings > Advanced Security.
security_settings_available() {
  [[ "$(jq -r '.private' <<<"$1")" != "true" ]]
}

# non_provider_patterns_available <current_repo_json>: whether non-provider
# patterns can be applied to this repo.
#
# GitHub honours the field only on organization-owned repositories. On a
# personal-account repo the PATCH is accepted with 200 and the field stays
# "disabled" - even an invalid status value is accepted there rather than
# rejected with a 422, so the request is being discarded wholesale rather than
# failing. Nothing in the response distinguishes that from success, so an
# ungated apply would trip assert_applied on every personal-account repo.
non_provider_patterns_available() {
  [[ "$(jq -r '.owner.type' <<<"$1")" == "Organization" ]]
}

# security_setting_skip_reason <field> <current_repo_json>: why that entry
# cannot be applied here, or empty when it can. One source of truth for the
# diff, the preview, and the apply.
security_setting_skip_reason() {
  local field="$1" current="$2"
  if ! security_settings_available "$current"; then
    echo "private repo - needs GitHub Secret Protection"
  elif [[ "$field" == "secret_scanning_non_provider_patterns" ]] \
    && ! non_provider_patterns_available "$current"; then
    echo "personal-account repo - needs an organization-owned repo"
  fi
}

# repo_settings_diff <current_repo_json>: print a change/no-change line per
# desired setting, comparing the current value to the desired value.
repo_settings_diff() {
  local current="$1" entry field cur reason
  for entry in "${REPO_SETTINGS[@]}"; do
    field="${entry%%|*}"
    cur="$(jq -r --arg f "$field" '.[$f]' <<<"$current")"
    if [[ "$cur" == "true" ]]; then
      printf '  %-39s true (no change)\n' "${field}:"
    else
      printf '  %-39s %s -> true (would change)\n' "${field}:" "$cur"
    fi
  done

  for entry in "${SECURITY_SETTINGS[@]}"; do
    field="${entry%%|*}"
    reason="$(security_setting_skip_reason "$field" "$current")"
    if [[ -n "$reason" ]]; then
      printf '  %-39s skipped (%s)\n' "${field}:" "$reason"
      continue
    fi
    cur="$(jq -r --arg f "$field" '.security_and_analysis[$f].status' <<<"$current")"
    if [[ "$cur" == "enabled" ]]; then
      printf '  %-39s enabled (no change)\n' "${field}:"
    else
      printf '  %-39s %s -> enabled (would change)\n' "${field}:" "$cur"
    fi
  done
}

# assert_applied <field> <actual> <expected>: die unless the API echoed back the
# value that was just requested. A PATCH that returns 200 is not proof the write
# landed, and a settings script is trusted precisely because it is not watched,
# so every write is read back. The PATCH response carries the resulting repo
# state, so this costs no extra request.
assert_applied() {
  local field="$1" actual="$2" expected="$3"
  [[ "$actual" == "$expected" ]] \
    || die "${OWNER_REPO} accepted the request but ${field} is '${actual}', not '${expected}'."
}

apply_repo_settings() {
  local args=() entry field response
  for entry in "${REPO_SETTINGS[@]}"; do
    field="${entry%%|*}"
    args+=(-F "${field}=true")
  done
  response="$(gh api --method PATCH "/repos/${OWNER_REPO}" "${args[@]}")" \
    || die "failed to update repo settings for ${OWNER_REPO} (need admin access)."
  for entry in "${REPO_SETTINGS[@]}"; do
    field="${entry%%|*}"
    assert_applied "$field" "$(jq -r --arg f "$field" '.[$f]' <<<"$response")" "true"
  done
}

# apply_security_settings: enable each SECURITY_SETTINGS entry. One PATCH per
# setting, not one batched call: it keeps a rejection attributable to the exact
# setting that failed, and it honours the enable order the array documents.
#
# gh's key[subkey]=value syntax builds the nested security_and_analysis object,
# so this stays an -F arg list like apply_repo_settings rather than a JSON body.
apply_security_settings() {
  local current="$1" entry field status
  for entry in "${SECURITY_SETTINGS[@]}"; do
    field="${entry%%|*}"
    [[ -z "$(security_setting_skip_reason "$field" "$current")" ]] || continue
    status="$(gh api --method PATCH "/repos/${OWNER_REPO}" \
      -F "security_and_analysis[${field}][status]=enabled" \
      --jq ".security_and_analysis.${field}.status")" \
      || die "failed to enable ${field} on ${OWNER_REPO} (need admin access, and GitHub Secret Protection on a private repo)."
    assert_applied "$field" "$status" "enabled"
  done
}

# dependabot_state <endpoint>: "enabled", "disabled", or "unknown".
#
# The status line is read rather than gh's exit code, so a 404 - a real answer
# meaning "not enabled" - stays distinct from a transport or auth failure, which
# must never be reported as "not enabled". Repo access is already proven by the
# GET in run_repo_settings_section, which dies first if the repo is unreachable.
#
# The two endpoints answer differently. vulnerability-alerts is a bare status
# code: 204 enabled, 404 not. automated-security-fixes returns a JSON body with
# an "enabled" boolean; GitHub documents a 404 when Dependabot is off, but it
# currently answers 200 with enabled=false, so both shapes are accepted.
dependabot_state() {
  local endpoint="$1" response code body enabled
  response="$(gh api -i "/repos/${OWNER_REPO}/${endpoint}" 2>/dev/null)" || true
  code="$(printf '%s\n' "$response" | awk 'NR==1 && $1 ~ /^HTTP/ { print $2; exit }')"

  case "$code" in
    204) echo enabled;  return 0 ;;
    404) echo disabled; return 0 ;;
    200) ;;
    *)   echo unknown;  return 0 ;;
  esac

  # Only automated-security-fixes answers 200, and only with a body. jq reads
  # .enabled directly rather than through `//`, which would fold false into the
  # fallback and report an explicitly-disabled setting as unknown.
  body="$(printf '%s\n' "$response" | awk 'blank { print } /^\r?$/ { blank = 1 }')"
  enabled="$(jq -r '.enabled' <<<"$body" 2>/dev/null)" || enabled=""
  case "$enabled" in
    true)  echo enabled ;;
    false) echo disabled ;;
    *)     echo unknown ;;
  esac
}

# dependabot_settings_diff: print a change/no-change line per Dependabot setting.
# Unlike repo_settings_diff this takes no repo JSON, since neither setting is
# carried on the repo response; each state costs its own request.
dependabot_settings_diff() {
  local entry endpoint cur
  for entry in "${DEPENDABOT_SETTINGS[@]}"; do
    endpoint="${entry%%|*}"
    cur="$(dependabot_state "$endpoint")"
    if [[ "$cur" == "enabled" ]]; then
      printf '  %-39s enabled (no change)\n' "${endpoint}:"
    else
      printf '  %-39s %s -> enabled (would change)\n' "${endpoint}:" "$cur"
    fi
  done
}

# apply_dependabot_setting <endpoint> <label>: PUT the sub-resource, then read
# the state back. The PUT answers 204 with no body, so unlike the PATCH writes
# there is nothing to inspect in the response - the state is re-read instead.
apply_dependabot_setting() {
  local endpoint="$1" label="$2"
  gh api --method PUT "/repos/${OWNER_REPO}/${endpoint}" >/dev/null \
    || die "failed to enable ${label} on ${OWNER_REPO} (need admin access)."
  assert_applied "$endpoint" "$(dependabot_state "$endpoint")" "enabled"
}

run_dependabot_section() {
  echo
  echo "Dependabot:"
  local entry endpoint label state

  if [[ -n "$DRY_RUN" ]]; then
    dependabot_settings_diff
    echo "  malware alerts: npm-only, no API - verify in Settings UI"
    return 0
  fi

  for entry in "${DEPENDABOT_SETTINGS[@]}"; do
    endpoint="${entry%%|*}"
    label="${entry#*|}"
    state="$(dependabot_state "$endpoint")"
    if [[ "$state" == "enabled" ]]; then
      printf '  %-31s already enabled\n' "${endpoint}:"
      continue
    fi
    if confirm "$label"; then
      apply_dependabot_setting "$endpoint" "$label"
      echo "  enabled ${label}."
    else
      echo "  skipped."
    fi
  done

  echo 'Note: Dependabot malware alerts are npm-only and have no API. Check them in Settings > Advanced Security.'
}

run_repo_settings_section() {
  echo
  echo "Repo settings:"
  local current entry field label reason
  # Fetched to preflight repo access (dies on failure), to diff current vs
  # desired in the dry-run branch below, and to read the repo visibility and
  # owner type the security-settings gates need. The flat settings are set
  # unconditionally.
  current="$(gh api "/repos/${OWNER_REPO}")" \
    || die "failed to read repo settings for ${OWNER_REPO} (check the repo exists and gh is authenticated)."

  if [[ -n "$DRY_RUN" ]]; then
    repo_settings_diff "$current"
    echo "  auto-close linked issues: no API, on by default - verify in Settings UI"
    return 0
  fi

  for entry in "${REPO_SETTINGS[@]}"; do
    field="${entry%%|*}"
    label="${entry#*|}"
    printf '  %-37s = true    (%s)\n' "$field" "$label"
  done
  for entry in "${SECURITY_SETTINGS[@]}"; do
    field="${entry%%|*}"
    label="${entry#*|}"
    reason="$(security_setting_skip_reason "$field" "$current")"
    if [[ -z "$reason" ]]; then
      printf '  %-37s = enabled (%s)\n' "$field" "$label"
    else
      printf '  %-37s = skipped (%s - %s)\n' "$field" "$label" "$reason"
    fi
  done
  echo "  auto-close linked issues: no API, on by default - verify in Settings UI"

  if confirm "repo settings"; then
    apply_repo_settings
    apply_security_settings "$current"
    echo 'Note: "Auto-close issues with merged linked pull requests" has no API. It is enabled by default - verify in Settings > General if needed.'
  else
    echo "  skipped."
  fi
}

# ---------------------------------------------------------------------------
# Plane autolink
#
# Turns a bare work-item identifier in a commit message (DX-49) into a link to
# the work item in Plane. GitHub applies autolinks to commit messages, PR and
# issue bodies, and release descriptions - never to PR or issue titles.
#
# Both halves come from .plane.yml, the config the Plane skills already read:
# `project` supplies the key prefix, `workspace` the path segment. The file is
# read from the local checkout only when its origin matches the target repo, so
# running this from one repo cannot stamp another repo's identifiers.
# ---------------------------------------------------------------------------

# plane_config_path: print the path to the .plane.yml governing the target repo,
# or nothing. Root-level wins over tmp/, matching the Plane skills' discovery.
plane_config_path() {
  local toplevel origin
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  [[ -n "$toplevel" ]] || return 0

  origin="$(git remote get-url origin 2>/dev/null)" || return 0
  [[ "$(parse_repo "$origin" 2>/dev/null)" == "$OWNER_REPO" ]] || return 0

  if [[ -f "${toplevel}/.plane.yml" ]]; then
    printf '%s\n' "${toplevel}/.plane.yml"
  elif [[ -f "${toplevel}/tmp/.plane.yml" ]]; then
    printf '%s\n' "${toplevel}/tmp/.plane.yml"
  fi
}

# plane_config_value <file> <key>: print a top-level scalar from a .plane.yml.
# Deliberately not a YAML parser. Only an unindented `key: value` line matches,
# so a commented-out key and a nested key of the same name both read as absent -
# which is the answer that makes the caller skip rather than guess.
plane_config_value() {
  local file="$1" key="$2"
  awk -v key="$key" '
    index($0, key ":") == 1 {
      sub("^" key "[[:space:]]*:[[:space:]]*", "")
      sub(/[[:space:]]*#.*$/, "")
      gsub(/^["\047]+|["\047]+$/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }
  ' "$file"
}

# autolink_desired: print "key_prefix|url_template", or "!reason" when the Plane
# config cannot supply both halves. The reason rides on the same line because
# the caller reads this through a command substitution, where a global set here
# would die with the subshell.
autolink_desired() {
  local file project workspace prefix

  file="$(plane_config_path)"
  if [[ -z "$file" ]]; then
    printf '!no .plane.yml for this repo in the current directory\n'
    return 0
  fi

  project="$(plane_config_value "$file" project)"
  workspace="$(plane_config_value "$file" workspace)"

  if [[ -z "$project" ]]; then
    printf '!%s sets no project\n' "$file"
    return 0
  fi
  # The prefix has to be the identifier Plane stamps on work items (the DX in
  # DX-49), not a display name. A name would build an autolink that matches
  # nothing anyone ever writes, which reads as configured but is inert.
  if [[ ! "$project" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]; then
    printf '!project "%s" is a name, not a Plane identifier\n' "$project"
    return 0
  fi
  if [[ -z "$workspace" ]]; then
    printf '!%s sets no workspace\n' "$file"
    return 0
  fi

  prefix="$(printf '%s' "$project" | tr '[:lower:]' '[:upper:]')-"
  printf '%s|https://app.plane.so/%s/browse/%s<num>/\n' "$prefix" "$workspace" "$prefix"
}

# autolink_lookup <key_prefix> <field>: print that field of the autolink holding
# the prefix, or nothing when the repo has no such autolink.
autolink_lookup() {
  local prefix="$1" field="$2"
  gh api "/repos/${OWNER_REPO}/autolinks" 2>/dev/null \
    | jq -r --arg p "$prefix" --arg f "$field" \
      'map(select(.key_prefix == $p)) | .[0][$f] // empty' 2>/dev/null || true
}

# autolink_state <key_prefix> <url_template>: "match", "absent", or
# "mismatch <current-template>".
autolink_state() {
  local prefix="$1" want="$2" have
  have="$(autolink_lookup "$prefix" url_template)"
  if [[ -z "$have" ]]; then
    echo "absent"
  elif [[ "$have" == "$want" ]]; then
    echo "match"
  else
    echo "mismatch ${have}"
  fi
}

# apply_autolink <key_prefix> <url_template> [existing_id]: create the autolink,
# deleting the prefix's current entry first when one is passed. GitHub has no
# update endpoint for autolinks, so replacing one is delete-then-create.
#
# is_alphanumeric is false because a Plane identifier's suffix is always an
# integer; the API defaults it to true, which would also match DX-49a.
apply_autolink() {
  local prefix="$1" template="$2" id="${3:-}"

  if [[ -n "$id" ]]; then
    gh api --method DELETE "/repos/${OWNER_REPO}/autolinks/${id}" >/dev/null \
      || die "failed to remove the existing ${prefix} autolink on ${OWNER_REPO} (need admin access)."
  fi

  gh api --method POST "/repos/${OWNER_REPO}/autolinks" \
    -f "key_prefix=${prefix}" \
    -f "url_template=${template}" \
    -F is_alphanumeric=false >/dev/null \
    || die "failed to create the ${prefix} autolink on ${OWNER_REPO} (need admin access)."
}

run_autolink_section() {
  echo
  echo "Plane autolink:"
  local desired prefix template state id

  desired="$(autolink_desired)"
  if [[ "$desired" == '!'* ]]; then
    echo "  skipped (${desired#!})."
    return 0
  fi

  prefix="${desired%%|*}"
  template="${desired#*|}"
  state="$(autolink_state "$prefix" "$template")"

  if [[ -n "$DRY_RUN" ]]; then
    case "$state" in
      match)     printf '  %-39s configured (no change)\n' "${prefix}" ;;
      absent)    printf '  %-39s absent -> %s (would change)\n' "${prefix}" "$template" ;;
      mismatch*) printf '  %-39s %s -> %s (would replace)\n' "${prefix}" "${state#mismatch }" "$template" ;;
    esac
    return 0
  fi

  case "$state" in
    match)
      printf '  %-31s already configured\n' "${prefix}"
      return 0
      ;;
    mismatch*)
      echo "  ${prefix} currently points at ${state#mismatch }"
      if confirm "replacing the ${prefix} autolink with ${template}"; then
        id="$(autolink_lookup "$prefix" id)"
        apply_autolink "$prefix" "$template" "$id"
        echo "  replaced the ${prefix} autolink."
      else
        echo "  skipped."
        return 0
      fi
      ;;
    absent)
      echo "  ${prefix} -> ${template}"
      if confirm "the ${prefix} autolink"; then
        apply_autolink "$prefix" "$template"
        echo "  created the ${prefix} autolink."
      else
        echo "  skipped."
        return 0
      fi
      ;;
  esac

  echo 'Note: autolinks render in commit messages, PR bodies and release descriptions - not in PR or issue titles.'
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
  DRY_RUN=""
  local repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)    usage; exit 0 ;;
      -n|--dry-run) DRY_RUN=1; shift ;;
      -*)           usage >&2; exit 1 ;;
      *)            [[ -z "$repo" ]] || { usage >&2; exit 1; }; repo="$1"; shift ;;
    esac
  done

  [[ -n "$repo" ]] || { usage >&2; exit 1; }

  command -v gh >/dev/null 2>&1 || die "gh CLI not found on PATH."
  command -v jq >/dev/null 2>&1 || die "jq not found on PATH."

  OWNER_REPO="$(parse_repo "$repo")"

  if [[ -n "$DRY_RUN" ]]; then
    echo "Dry run for ${OWNER_REPO} (no changes will be made)..."
  else
    echo "Configuring ${OWNER_REPO}..."
  fi

  run_rulesets_section

  run_repo_settings_section

  run_dependabot_section

  run_autolink_section

  echo "Done."
}

# Sourced with _GH_SETTINGS_LIB_ONLY=1 (by tests): define functions and stop
# before parsing args or touching the network.
if [[ -n "${_GH_SETTINGS_LIB_ONLY:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
