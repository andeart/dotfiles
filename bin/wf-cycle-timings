#!/usr/bin/env bash
#
# Report per-reviewer phase timings for a wf-impl-review or wf-spec-review
# cycle. Point it at one cycle's own subagents directory; a session that ran
# both a spec review and an impl review for the same ticket holds two rosters
# side by side, and this refuses rather than merging them.
#
# Reads only reviewer sub-agent transcripts, never the coordinator's, and no
# review skill invokes it. Running it therefore cannot appear in the numbers
# it reports.
#
# Usage: wf-cycle-timings [--porcelain] <session-dir | subagents-dir>
#
# Exit codes:
#   0   timings printed for at least one reviewer.
#   2   a usage error, no reviewer transcript found, or the target mixes Impl
#       review and Spec review agents from two different cycles.

set -euo pipefail

# The follow-through prompt's opening words, as they appear in both
# agents/skills/wf-impl-review/SKILL.md and agents/skills/wf-spec-review/SKILL.md.
# tests/wf-cycle-timings.bats pins this against both files: a reworded
# follow-through must change here too, or every phase split silently becomes
# the whole run.
FOLLOWTHROUGH_MARKER="You're not obligated to, but you can now "

usage() {
  cat <<'EOF'
Usage: wf-cycle-timings [--porcelain] <session-dir | subagents-dir>

Report per-reviewer read-only and follow-through timings for one review cycle.

  --porcelain   Tab-separated output for scripts. Row types:
                  reviewer <name> <read_only_s> <follow_s> <total_s> <turnaround_s>
                  nested   <parent> <description> <duration_s> <read-only|follow>
                  gap      <from> <to> <seconds>
                  totals   <read_only_s> <follow_s> <active_s> <span_s> <gaps_s>
  --help        This text.

Coordinator turnaround - the wait between a reviewer's last output and the
follow-through arriving - is reported separately and counted in neither phase.
EOF
}

die() {
  echo "wf-cycle-timings: $1" >&2
  exit "${2:-2}"
}

# fmt_duration <seconds>: NmSSs, e.g. 227 -> 3m47s.
fmt_duration() {
  printf '%dm%02ds\n' $(( $1 / 60 )) $(( $1 % 60 ))
}

# subagents_dir <path>: echo the subagents directory for a session dir, or the
# path itself when it already is one.
subagents_dir() {
  if [ -d "$1/subagents" ]; then
    printf '%s\n' "$1/subagents"
  elif [ -d "$1" ]; then
    printf '%s\n' "$1"
  else
    die "not a directory: $1"
  fi
}

# _meta_scan <subagents-dir>: "1<TAB>id<TAB>kind<TAB>name" per depth-1 review
# agent, "2<TAB>id<TAB>parent<TAB>description" per depth-2 agent - one row per
# agent-*.meta.json file matching either shape. One jq process reads the whole
# glob; `input_filename` recovers each file's own path without slurping, so
# memory stays one record at a time.
#
# A parse error in one file aborts jq's read of every file after it in the
# argument list. Falls back to a per-file loop on nonzero exit, so a corrupt
# meta file costs this function its speed rather than costing every agent
# ordered after it in the glob.
_meta_scan() {
  local -a files=("$1"/agent-*.meta.json)
  [ -e "${files[0]}" ] || return 0
  local filter out
  filter='
    (input_filename | sub(".*/agent-";"") | sub("\\.meta\\.json$";"")) as $id
    | if (.spawnDepth == 1) then
        (.description | capture("^(?<kind>Impl|Spec) review: (?<name>.*)")?) as $m
        | if ($m == null) then empty else [1, $id, $m.kind, $m.name] | @tsv end
      elif (.spawnDepth == 2) then
        [2, $id, (.parentAgentId // ""), (.description // "(no description)")] | @tsv
      else empty end'
  if out="$(jq -r "$filter" "${files[@]}" 2>/dev/null)"; then
    printf '%s\n' "$out"
    return 0
  fi
  local meta
  for meta in "${files[@]}"; do
    jq -r "$filter" "$meta" 2>/dev/null || true
  done
}

# reviewers <subagents-dir> [scan]: "id<TAB>name<TAB>read_only<TAB>follow<TAB>
# total<TAB>turnaround<TAB>start<TAB>end<TAB>ft" per depth-1 review agent,
# ordered by transcript start so the roster reads in cycle order. The last
# seven fields are transcript_stats()'s output, carried forward because the
# start-time sort key already costs that pass per candidate; main() reads them
# rather than calling transcript_stats() again per reviewer.
#
# Refuses a directory whose depth-1 review agents mix "Impl review:" and
# "Spec review:" prefixes. One session can run both for the same ticket (spec
# review, then implementation, then impl review, per WORKFLOW.md), and merged
# rosters repeat reviewer names and give span and gap numbers spanning both
# cycles - wrong, but not visibly so.
#
# `scan` is _meta_scan() output for this directory, shared by main() with
# nested_by_parent() so the classification pass is paid once. Omitted, this
# scans the directory itself.
reviewers() {
  local scan="${2:-}"
  [ -n "$scan" ] || scan="$(_meta_scan "$1")"
  [ -n "$scan" ] || return 0

  local id kind name stats start rows
  rows="$(
    printf '%s\n' "$scan" | awk -F'\t' '$1 == 1' | while IFS=$'\t' read -r _ id kind name; do
      [ -n "$id" ] || continue
      stats="$(transcript_stats "$1/agent-$id.jsonl")"
      start="$(printf '%s\n' "$stats" | cut -d' ' -f5)"
      printf '%s\t%s\t%s\t%s\t%s\n' "$start" "$id" "$name" "$kind" "${stats// /$'\t'}"
    done
  )"
  [ -n "$rows" ] || return 0

  local kind_count
  kind_count="$(printf '%s\n' "$rows" | cut -f4 | sort -u | wc -l | tr -d ' ')"
  [ "$kind_count" -le 1 ] || \
    die "found both Impl review and Spec review agents under $1 - point this at one cycle's subagents directory; a session that ran both isn't one cycle"

  printf '%s\n' "$rows" | sort -n | cut -f2,3,5-11
}

# stamps <jsonl>: "<epoch>\t<ft|->" per timestamped record. Lines are parsed
# one at a time with `fromjson?`, and an unparseable timestamp value is dropped
# by `fromdateiso8601?`, so a truncated or malformed record is skipped rather
# than aborting the stream. Losing every record after one bad line would
# silently shorten whichever phase it lands in.
#
# The follow-through match requires `.message.content` to be a plain string,
# not merely a `.type == "user"` record containing the marker. Tool results
# share that type but carry an array of content blocks; only a coordinator
# interjection is a bare string. Both review SKILL.md files quote the marker
# verbatim, so a reviewer reading either one - which reviewing this file
# requires - echoes it into its own transcript. Without the type check that
# echo is mistaken for the follow-through and every phase split collapses.
stamps() {
  [ -f "$1" ] || return 0
  jq -R -r --arg m "$FOLLOWTHROUGH_MARKER" '
    fromjson?
    | select(.timestamp != null)
    | ((.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601?) | tostring) as $t
    | if (.type == "user")
         and ((.message.content | type) == "string")
         and (.message.content | contains($m))
      then $t + "\tft"
      else $t + "\t-"
      end' "$1"
}

# transcript_stats <jsonl>: "read_only follow total turnaround start end ft",
# integer seconds and epochs, from one pass over stamps(). phases(), bounds()
# and followthrough() slice fields out of this rather than running their own
# `awk`, so the boundary logic - where read-only ends, where a nested spawn's
# phase splits - lives in exactly one place.
transcript_stats() {
  stamps "$1" | awk -F'\t' '
    { t[NR] = $1 + 0; f[NR] = $2 }
    END {
      if (NR == 0) { print "0 0 0 0 0 0 0"; exit }
      start = t[1]; end = t[1]; haveft = 0
      for (i = 1; i <= NR; i++) {
        if (t[i] < start) start = t[i]
        if (t[i] > end)   end   = t[i]
        if (f[i] == "ft" && (!haveft || t[i] < ft)) { ft = t[i]; haveft = 1 }
      }
      if (!haveft) { printf "%d 0 %d 0 %d %d 0\n", end - start, end - start, start, end; exit }
      roend = start
      for (i = 1; i <= NR; i++) if (t[i] < ft && t[i] > roend) roend = t[i]
      printf "%d %d %d %d %d %d %d\n", roend - start, end - ft, end - start, ft - roend, start, end, ft
    }'
}

# phases <jsonl>: "read_only follow total turnaround", the first four
# transcript_stats() fields. A named entry point for one slice of that output;
# no in-file caller, exercised by its own tests.
phases() {
  transcript_stats "$1" | cut -d' ' -f1-4
}

# bounds <jsonl>: "<start-epoch> <end-epoch>", for nested() and
# nested_by_parent()'s duration and phase math.
bounds() {
  transcript_stats "$1" | cut -d' ' -f5-6
}

# followthrough <jsonl>: the epoch the follow-through arrived at, or 0 when
# none did, so a nested spawn can be placed on the right side of it. A named
# entry point for one slice of transcript_stats(); no in-file caller.
followthrough() {
  transcript_stats "$1" | cut -d' ' -f7
}

# nested <subagents-dir> <parent-id> <parent-followthrough-epoch>:
# "description<TAB>duration<TAB>phase" per depth-2 agent under that parent.
# Reviewers are told not to spawn these, and this is how that is measured. The
# phase is where the child started, since only read-only spawns bear on the
# acceptance criterion. A parent passed 0 never received a follow-through and
# has no follow phase for a child to land in, so everything under it is
# read-only, matching how transcript_stats() reads it. Single-parent entry
# point; main() calls nested_by_parent().
nested() {
  local meta id desc b start phase
  for meta in "$1"/agent-*.meta.json; do
    [ -e "$meta" ] || continue
    desc="$(jq -r --arg p "$2" '
      if (.spawnDepth == 2) and (.parentAgentId == $p)
      then (.description // "(no description)")
      else empty end' "$meta" 2>/dev/null || true)"
    [ -n "$desc" ] || continue
    # Tabs and newlines would corrupt the TSV row, and \r mangles it visually.
    # This is a sub-agent's own free-text description, and this function exists
    # to surface sub-agents that already broke the no-nested-spawns rule - the
    # wrong population to trust to be well-formed.
    desc="${desc//$'\t'/ }"
    desc="${desc//$'\n'/ }"
    desc="${desc//$'\r'/ }"
    id="${meta##*/agent-}"
    id="${id%.meta.json}"
    b="$(bounds "$1/agent-$id.jsonl")"
    start="${b%% *}"
    phase=read-only
    if [ "${3:-0}" -gt 0 ] && [ "$start" -ge "${3:-0}" ]; then phase=follow; fi
    printf '%s\t%d\t%s\n' "$desc" "$(( ${b#* } - start ))" "$phase"
  done
}

# nested_by_parent <subagents-dir> [scan]: "parent<TAB>description<TAB>
# duration<TAB>start" per depth-2 agent under any parent. Classifies the
# directory once through _meta_scan() and filters in memory, where calling
# nested() per reviewer would cost reviewers x total-agents against the
# filesystem - and a long-lived session accumulates every sub-agent it ever
# spawned, not just this cycle's. `scan` is the shared _meta_scan() output;
# omitted, this scans the directory itself.
nested_by_parent() {
  local scan="${2:-}"
  [ -n "$scan" ] || scan="$(_meta_scan "$1")"
  [ -n "$scan" ] || return 0

  local id parent desc b start
  printf '%s\n' "$scan" | awk -F'\t' '$1 == 2' | while IFS=$'\t' read -r _ id parent desc; do
    [ -n "$parent" ] || continue
    # @tsv already escapes tabs/newlines within desc as literal backslash
    # sequences rather than leaving raw control characters in place, so this
    # row's own tab-delimited grammar cannot be corrupted the way nested()'s
    # manual sanitization above guards against.
    b="$(bounds "$1/agent-$id.jsonl")"
    start="${b%% *}"
    printf '%s\t%s\t%d\t%d\n' "$parent" "$desc" "$(( ${b#* } - start ))" "$start"
  done
}

main() {
  local porcelain=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --porcelain) porcelain=1 ;;
      --help|-h)   usage; exit 0 ;;
      -*)          usage >&2; die "unknown option: $1" ;;
      *)           [ -n "$target" ] && { usage >&2; die "more than one path given"; }
                   target="$1" ;;
    esac
    shift
  done
  [ -n "$target" ] || { usage >&2; exit 2; }

  local dir
  dir="$(subagents_dir "$target")"

  # One _meta_scan() pass over the directory, shared by reviewers() and
  # nested_by_parent() below - see _meta_scan()'s own comment for why calling
  # each of those alone would otherwise pay for that pass twice.
  local scan
  scan="$(_meta_scan "$dir")"

  local roster
  roster="$(reviewers "$dir" "$scan")"
  [ -n "$roster" ] || die "no reviewer transcript found under $dir"

  local id name ro fo to tu st en ft
  local sum_ro=0 sum_fo=0 span_start=0 span_end=0 first=1
  local -a ids=() names=() ros=() fos=() tos=() tus=() starts=() ends=() fts=()

  while IFS="$(printf '\t')" read -r id name ro fo to tu st en ft; do
    [ -n "$id" ] || continue
    ids+=("$id"); names+=("$name"); ros+=("$ro"); fos+=("$fo"); tos+=("$to"); tus+=("$tu")
    starts+=("$st"); ends+=("$en"); fts+=("$ft")
    sum_ro=$(( sum_ro + ro )); sum_fo=$(( sum_fo + fo ))
    if [ "$first" -eq 1 ] || [ "$st" -lt "$span_start" ]; then span_start="$st"; fi
    if [ "$first" -eq 1 ] || [ "$en" -gt "$span_end" ]; then span_end="$en"; fi
    first=0
  done <<EOF
$roster
EOF

  local active=$(( sum_ro + sum_fo ))
  local span=$(( span_end - span_start ))
  local i gaps=0 g
  for (( i = 1; i < ${#names[@]}; i++ )); do
    g=$(( starts[i] - ends[i-1] ))
    [ "$g" -gt 0 ] && gaps=$(( gaps + g ))
  done

  if [ "$porcelain" -eq 1 ]; then
    for (( i = 0; i < ${#names[@]}; i++ )); do
      printf 'reviewer\t%s\t%d\t%d\t%d\t%d\n' \
        "${names[i]}" "${ros[i]}" "${fos[i]}" "${tos[i]}" "${tus[i]}"
    done
  else
    printf '%-10s %8s %9s %9s %11s\n' Name review follow total turnaround
    for (( i = 0; i < ${#names[@]}; i++ )); do
      printf '%-10s %8s %9s %9s %11s\n' "${names[i]}" \
        "$(fmt_duration "${ros[i]}")" "$(fmt_duration "${fos[i]}")" \
        "$(fmt_duration "${tos[i]}")" "$(fmt_duration "${tus[i]}")"
    done
    echo
  fi

  # One pass over the directory for every reviewer's nested spawns, instead of
  # nested()'s one call per reviewer - see nested_by_parent()'s own comment.
  # Each reviewer's rows are then just filtered out of this in-memory result.
  # Reuses the scan computed above rather than re-running _meta_scan().
  local all_nested
  all_nested="$(nested_by_parent "$dir" "$scan")"

  local ro_count=0 ro_nested=0 fo_count=0 fo_nested=0 desc dur phase
  for (( i = 0; i < ${#names[@]}; i++ )); do
    while IFS="$(printf '\t')" read -r desc dur phase; do
      [ -n "$desc" ] || continue
      if [ "$phase" = "read-only" ]; then
        ro_count=$(( ro_count + 1 )); ro_nested=$(( ro_nested + dur ))
      else
        fo_count=$(( fo_count + 1 )); fo_nested=$(( fo_nested + dur ))
      fi
      if [ "$porcelain" -eq 1 ]; then
        printf 'nested\t%s\t%s\t%d\t%s\n' "${names[i]}" "$desc" "$dur" "$phase"
      else
        printf '  nested: %-10s %-34s %-9s %8s\n' \
          "${names[i]}" "$desc" "$phase" "$(fmt_duration "$dur")"
      fi
    done <<EOF
$(printf '%s\n' "$all_nested" | awk -F'\t' -v p="${ids[i]}" -v ft="${fts[i]}" '
  $1 == p {
    phase = "read-only"
    if (ft > 0 && $4 >= ft) phase = "follow"
    print $2 "\t" $3 "\t" phase
  }')
EOF
  done

  for (( i = 1; i < ${#names[@]}; i++ )); do
    g=$(( starts[i] - ends[i-1] ))
    [ "$g" -gt 0 ] || continue
    if [ "$porcelain" -eq 1 ]; then
      printf 'gap\t%s\t%s\t%d\n' "${names[i-1]}" "${names[i]}" "$g"
    fi
  done

  if [ "$porcelain" -eq 1 ]; then
    printf 'totals\t%d\t%d\t%d\t%d\t%d\n' "$sum_ro" "$sum_fo" "$active" "$span" "$gaps"
  else
    local pct=0
    [ "$active" -gt 0 ] && pct=$(( sum_ro * 1000 / active ))
    printf 'read-only  %s (%d.%d%%)\n' "$(fmt_duration "$sum_ro")" $(( pct / 10 )) $(( pct % 10 ))
    printf 'follow     %s\n' "$(fmt_duration "$sum_fo")"
    printf 'active     %s\n' "$(fmt_duration "$active")"
    printf 'span       %s\n' "$(fmt_duration "$span")"
    printf 'gaps       %s across %d\n' "$(fmt_duration "$gaps")" $(( ${#names[@]} - 1 ))
    printf 'nested     read-only %d spawn(s), %s; follow %d spawn(s), %s\n' \
      "$ro_count" "$(fmt_duration "$ro_nested")" \
      "$fo_count" "$(fmt_duration "$fo_nested")"
  fi
}

# Sourced with _WF_CYCLE_TIMINGS_LIB_ONLY=1 (by tests): define functions and
# stop before parsing args or reading a transcript.
if [ -n "${_WF_CYCLE_TIMINGS_LIB_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
