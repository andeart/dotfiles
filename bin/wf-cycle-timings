#!/usr/bin/env bash
#
# Report per-reviewer phase timings for a wf-impl-review or wf-spec-review
# cycle. Point it at one cycle's own subagents directory - a long-lived
# session that ran both a /wf-spec-review and a /wf-impl-review for the same
# ticket holds two cycles' reviewer agents side by side, and this refuses to
# guess which one you mean rather than merging both into one roster.
#
# Reads only the reviewer sub-agent transcripts under a session's subagents/
# directory. It never reads the coordinator transcript, and neither review
# skill ever invokes it, so running this cannot appear in the numbers it
# reports. That immunity is the reason the tool exists in this shape rather
# than as a step inside the cycle.
#
# Usage: wf-cycle-timings [--porcelain] <session-dir | subagents-dir>
#
# Exit codes:
#   0   timings printed for at least one reviewer.
#   2   a usage error, no reviewer transcript found, or the target mixes Impl
#       review and Spec review agents from two different cycles.

set -euo pipefail

# The follow-through prompt's opening words, as they appear in both
# agents/skills/wf-impl-review/SKILL.md and agents/skills/wf-spec-review/SKILL.md.
# tests/wf-cycle-timings.bats pins this against both files: a reworded
# follow-through must change here too, or every phase split silently becomes
# the whole run.
FOLLOWTHROUGH_MARKER="You're not obligated to, but you can now "

usage() {
  cat <<'EOF'
Usage: wf-cycle-timings [--porcelain] <session-dir | subagents-dir>

Report per-reviewer read-only and follow-through timings for one review cycle.

  --porcelain   Tab-separated output for scripts. Row types:
                  reviewer <name> <read_only_s> <follow_s> <total_s> <turnaround_s>
                  nested   <parent> <description> <duration_s> <read-only|follow>
                  gap      <from> <to> <seconds>
                  totals   <read_only_s> <follow_s> <active_s> <span_s> <gaps_s>
  --help        This text.

Coordinator turnaround - the wait between a reviewer's last output and the
follow-through arriving - is reported separately and counted in neither phase.
EOF
}

die() {
  echo "wf-cycle-timings: $1" >&2
  exit "${2:-2}"
}

# fmt_duration <seconds>: NmSSs, e.g. 227 -> 3m47s.
fmt_duration() {
  printf '%dm%02ds\n' $(( $1 / 60 )) $(( $1 % 60 ))
}

# subagents_dir <path>: echo the subagents directory for a session dir, or the
# path itself when it already is one.
subagents_dir() {
  if [ -d "$1/subagents" ]; then
    printf '%s\n' "$1/subagents"
  elif [ -d "$1" ]; then
    printf '%s\n' "$1"
  else
    die "not a directory: $1"
  fi
}

# _meta_scan <subagents-dir>: "1<TAB>id<TAB>kind<TAB>name" per depth-1 review
# agent, "2<TAB>id<TAB>parent<TAB>description" per depth-2 agent - one row per
# agent-*.meta.json file that matches either shape. reviewers() and
# nested_by_parent() each used to run this same classification as their own
# bash loop, launching one jq process per file - two full-directory passes,
# each spawning one jq process per file. Measured against 604 meta files (a
# plausible count for a busy long-lived session - see nested_by_parent()'s own
# history below): those two loops cost 3.8s combined; this one process reading
# every file directly costs 0.02-0.08s. `input_filename` recovers each file's
# own path without slurping, so per-file `id` extraction still works and
# memory stays one record at a time rather than the whole directory.
#
# A parse error in one file aborts jq's read of every file ordered after it in
# the argument list - streaming many files through one process trades away the
# per-file fault isolation the old one-jq-per-file loops had for free. Falls
# back to that slower, isolated loop whenever the fast path's process exits
# nonzero, so a single corrupt meta file costs this function its speed rather
# than costing every reviewer or nested spawn ordered after it in the glob.
_meta_scan() {
  local -a files=("$1"/agent-*.meta.json)
  [ -e "${files[0]}" ] || return 0
  local filter out
  filter='
    (input_filename | sub(".*/agent-";"") | sub("\\.meta\\.json$";"")) as $id
    | if (.spawnDepth == 1) then
        (.description | capture("^(?<kind>Impl|Spec) review: (?<name>.*)")?) as $m
        | if ($m == null) then empty else [1, $id, $m.kind, $m.name] | @tsv end
      elif (.spawnDepth == 2) then
        [2, $id, (.parentAgentId // ""), (.description // "(no description)")] | @tsv
      else empty end'
  if out="$(jq -r "$filter" "${files[@]}" 2>/dev/null)"; then
    printf '%s\n' "$out"
    return 0
  fi
  local meta
  for meta in "${files[@]}"; do
    jq -r "$filter" "$meta" 2>/dev/null || true
  done
}

# reviewers <subagents-dir> [scan]: "id<TAB>name<TAB>read_only<TAB>follow<TAB>
# total<TAB>turnaround<TAB>start<TAB>end<TAB>ft" per depth-1 review agent (the
# last seven fields are transcript_stats()'s own output, unpacked), ordered by
# the start of its transcript so the roster reads in cycle order. main() reads
# these fields directly instead of calling transcript_stats() again per
# reviewer - sorting the roster already requires a full transcript_stats() pass
# per candidate for its start-time sort key, so carrying the rest of that same
# call's output forward is free; recomputing it in main() afterward was not
# (measured: ~0.45s for one transcript_stats() pass over a 20,000-line
# transcript, ~0.78s for the two passes this used to cost per reviewer).
# Refuses a directory whose depth-1 review agents mix "Impl review:" and
# "Spec review:" prefixes: /wf-spec-review and /wf-impl-review for the same
# ticket can both run inside one continuous session (spec review, then "you
# implement", then impl review, per WORKFLOW.md), and without this check the
# two cycles' rosters silently merge into one with reviewer names repeated and
# span/gap numbers that span both cycles - wrong, but not visibly so.
# The optional second argument is _meta_scan()'s own output for this
# directory, for a caller (main()) that also needs nested_by_parent()'s
# classification of the same directory and would otherwise pay for that one
# pass twice. Omitted, this scans the directory itself, so calling this alone
# still works exactly as before.
reviewers() {
  local scan="${2:-}"
  [ -n "$scan" ] || scan="$(_meta_scan "$1")"
  [ -n "$scan" ] || return 0

  local id kind name stats start rows
  rows="$(
    printf '%s\n' "$scan" | awk -F'\t' '$1 == 1' | while IFS=$'\t' read -r _ id kind name; do
      [ -n "$id" ] || continue
      stats="$(transcript_stats "$1/agent-$id.jsonl")"
      start="$(printf '%s\n' "$stats" | cut -d' ' -f5)"
      printf '%s\t%s\t%s\t%s\t%s\n' "$start" "$id" "$name" "$kind" "${stats// /$'\t'}"
    done
  )"
  [ -n "$rows" ] || return 0

  local kind_count
  kind_count="$(printf '%s\n' "$rows" | cut -f4 | sort -u | wc -l | tr -d ' ')"
  [ "$kind_count" -le 1 ] || \
    die "found both Impl review and Spec review agents under $1 - point this at one cycle's subagents directory; a session that ran both isn't one cycle"

  printf '%s\n' "$rows" | sort -n | cut -f2,3,5-11
}

# stamps <jsonl>: "<epoch>\t<ft|->" per timestamped record. Lines are parsed
# one at a time with `fromjson?` so an unparseable line is skipped rather than
# aborting the stream - a transcript can carry a truncated line if the session
# was interrupted, and losing every record after it would silently shorten the
# phase it lands in. A well-formed line whose `timestamp` value is not an ISO
# date is dropped the same way, via `fromdateiso8601?` - a record with no
# usable timestamp cannot contribute to a min or max either way, so both cases
# fail silently rather than one of them printing a jq error every time
# transcript_stats() reads a transcript - phases(), bounds(), followthrough(),
# and reviewers() all go through it (main() reads reviewers()'s output instead
# of calling transcript_stats() again itself), and stamps() itself has exactly
# one caller now.
#
# The follow-through match requires `.message.content` to be a plain string,
# not just a `.type == "user"` record containing the marker. A tool result
# (reading either review SKILL.md, which documents this exact marker text
# verbatim in its follow-through prompt) is also recorded as `.type == "user"`,
# but its content is an array of content blocks, never a bare string - only a
# real coordinator interjection lands as a plain string. Without the type
# check, a reviewer that reads either SKILL.md during read-only review - which
# it is explicitly told to do, and which reviewing changes to this file
# requires - gets that text echoed back into its own transcript and this
# script mistakes it for the actual follow-through, landing on whichever comes
# first.
stamps() {
  [ -f "$1" ] || return 0
  jq -R -r --arg m "$FOLLOWTHROUGH_MARKER" '
    fromjson?
    | select(.timestamp != null)
    | ((.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601?) | tostring) as $t
    | if (.type == "user")
         and ((.message.content | type) == "string")
         and (.message.content | contains($m))
      then $t + "\tft"
      else $t + "\t-"
      end' "$1"
}

# transcript_stats <jsonl>: "read_only follow total turnaround start end ft",
# integer seconds/epochs, from one pass over stamps(). phases(), bounds(), and
# followthrough() below each slice a piece out of this instead of running
# their own `awk` over the same stream, so the boundary logic (where read-only
# ends, where a nested spawn's phase splits) exists in exactly one place -
# reviewers() calls this directly for all seven values at once per candidate,
# the reason it exists in this shape rather than as a fourth standalone
# function.
transcript_stats() {
  stamps "$1" | awk -F'\t' '
    { t[NR] = $1 + 0; f[NR] = $2 }
    END {
      if (NR == 0) { print "0 0 0 0 0 0 0"; exit }
      start = t[1]; end = t[1]; haveft = 0
      for (i = 1; i <= NR; i++) {
        if (t[i] < start) start = t[i]
        if (t[i] > end)   end   = t[i]
        if (f[i] == "ft" && (!haveft || t[i] < ft)) { ft = t[i]; haveft = 1 }
      }
      if (!haveft) { printf "%d 0 %d 0 %d %d 0\n", end - start, end - start, start, end; exit }
      roend = start
      for (i = 1; i <= NR; i++) if (t[i] < ft && t[i] > roend) roend = t[i]
      printf "%d %d %d %d %d %d %d\n", roend - start, end - ft, end - start, ft - roend, start, end, ft
    }'
}

# phases <jsonl>: "read_only follow total turnaround", integer seconds - the
# first four transcript_stats() fields. Nothing in this file calls phases()
# or followthrough() below - reviewers() reads transcript_stats()'s full
# output directly instead, for the reason given in reviewers()'s own comment.
# Both are kept anyway as a stable one-purpose entry point onto
# transcript_stats(), for a future caller in this file or elsewhere that wants
# just one of its fields without learning the other six, and are exercised
# only by their own tests today - if that's no longer worth the upkeep, delete
# them and fold their tests into transcript_stats()'s.
phases() {
  transcript_stats "$1" | cut -d' ' -f1-4
}

# bounds <jsonl>: "<start-epoch> <end-epoch>", for nested_by_parent()'s and
# nested()'s duration/phase math. Unlike phases()/followthrough() below, this
# one has live callers.
bounds() {
  transcript_stats "$1" | cut -d' ' -f5-6
}

# followthrough <jsonl>: the epoch the follow-through prompt arrived at, or 0
# when none did. phases() finds the same instant to split the two phases; this
# hands it out so a nested spawn can be placed on the right side of it. See
# phases()'s own comment above - no in-file caller today, kept as a named
# entry point for whoever needs just this one field next.
followthrough() {
  transcript_stats "$1" | cut -d' ' -f7
}

# nested <subagents-dir> <parent-id> <parent-followthrough-epoch>:
# "description<TAB>duration<TAB>phase" per depth-2 agent under that parent.
# Reviewers are told not to spawn these; this is how we find out whether that
# held. The phase is where the child started, since only spawns during
# read-only bear on acceptance criterion 7. A parent that never received a
# follow-through is passed 0 and has no follow phase for a child to land in,
# so everything under it is read-only - which is how phases() reads it too.
# Kept as its own single-parent entry point for standalone callers and the
# tests pinned to this exact shape; main() calls nested_by_parent() instead,
# for the reason given there.
nested() {
  local meta id desc b start phase
  for meta in "$1"/agent-*.meta.json; do
    [ -e "$meta" ] || continue
    desc="$(jq -r --arg p "$2" '
      if (.spawnDepth == 2) and (.parentAgentId == $p)
      then (.description // "(no description)")
      else empty end' "$meta" 2>/dev/null || true)"
    [ -n "$desc" ] || continue
    # A tab, newline or carriage return here would corrupt (or, for \r,
    # visually mangle) the TSV row below. This is a sub-agent's own free-text
    # description, and nested() exists precisely to surface sub-agents that
    # already broke a rule (the no-nested-spawns one), so it's the wrong
    # population to trust to be well-formed.
    desc="${desc//$'\t'/ }"
    desc="${desc//$'\n'/ }"
    desc="${desc//$'\r'/ }"
    id="${meta##*/agent-}"
    id="${id%.meta.json}"
    b="$(bounds "$1/agent-$id.jsonl")"
    start="${b%% *}"
    phase=read-only
    if [ "${3:-0}" -gt 0 ] && [ "$start" -ge "${3:-0}" ]; then phase=follow; fi
    printf '%s\t%d\t%s\n' "$desc" "$(( ${b#* } - start ))" "$phase"
  done
}

# nested_by_parent <subagents-dir> [scan]: "parent<TAB>description<TAB>
# duration<TAB>start" per depth-2 agent under any parent. nested() takes one
# parent id and is called once per reviewer in main()'s loop; since it
# re-globs and re-parses every meta file in the directory on every call, that
# cost is reviewers x total-agents in the directory, not just total-agents -
# and the directory can hold far more than this cycle's own reviewers, since a
# long-lived session accumulates every sub-agent it ever spawned. Measured
# against 4 reviewers plus 300 unrelated agents (604 meta files, a plausible
# count for a busy long-lived session): calling nested() once per reviewer
# cost 5.8s wall-clock; classifying the whole directory through _meta_scan()
# once, as this does, costs 0.02-0.08s - the per-reviewer filter runs in
# memory against that output rather than against the filesystem again. The
# optional second argument is the same _meta_scan() cache reviewers() takes,
# for the same reason; omitted, this scans the directory itself.
nested_by_parent() {
  local scan="${2:-}"
  [ -n "$scan" ] || scan="$(_meta_scan "$1")"
  [ -n "$scan" ] || return 0

  local id parent desc b start
  printf '%s\n' "$scan" | awk -F'\t' '$1 == 2' | while IFS=$'\t' read -r _ id parent desc; do
    [ -n "$parent" ] || continue
    # @tsv already escapes tabs/newlines within desc as literal backslash
    # sequences rather than leaving raw control characters in place, so this
    # row's own tab-delimited grammar cannot be corrupted the way nested()'s
    # manual sanitization above guards against.
    b="$(bounds "$1/agent-$id.jsonl")"
    start="${b%% *}"
    printf '%s\t%s\t%d\t%d\n' "$parent" "$desc" "$(( ${b#* } - start ))" "$start"
  done
}

main() {
  local porcelain=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --porcelain) porcelain=1 ;;
      --help|-h)   usage; exit 0 ;;
      -*)          usage >&2; die "unknown option: $1" ;;
      *)           [ -n "$target" ] && { usage >&2; die "more than one path given"; }
                   target="$1" ;;
    esac
    shift
  done
  [ -n "$target" ] || { usage >&2; exit 2; }

  local dir
  dir="$(subagents_dir "$target")"

  # One _meta_scan() pass over the directory, shared by reviewers() and
  # nested_by_parent() below - see _meta_scan()'s own comment for why calling
  # each of those alone would otherwise pay for that pass twice.
  local scan
  scan="$(_meta_scan "$dir")"

  local roster
  roster="$(reviewers "$dir" "$scan")"
  [ -n "$roster" ] || die "no reviewer transcript found under $dir"

  local id name ro fo to tu st en ft
  local sum_ro=0 sum_fo=0 span_start=0 span_end=0 first=1
  local -a ids=() names=() ros=() fos=() tos=() tus=() starts=() ends=() fts=()

  while IFS="$(printf '\t')" read -r id name ro fo to tu st en ft; do
    [ -n "$id" ] || continue
    ids+=("$id"); names+=("$name"); ros+=("$ro"); fos+=("$fo"); tos+=("$to"); tus+=("$tu")
    starts+=("$st"); ends+=("$en"); fts+=("$ft")
    sum_ro=$(( sum_ro + ro )); sum_fo=$(( sum_fo + fo ))
    if [ "$first" -eq 1 ] || [ "$st" -lt "$span_start" ]; then span_start="$st"; fi
    if [ "$first" -eq 1 ] || [ "$en" -gt "$span_end" ]; then span_end="$en"; fi
    first=0
  done <<EOF
$roster
EOF

  local active=$(( sum_ro + sum_fo ))
  local span=$(( span_end - span_start ))
  local i gaps=0 g
  for (( i = 1; i < ${#names[@]}; i++ )); do
    g=$(( starts[i] - ends[i-1] ))
    [ "$g" -gt 0 ] && gaps=$(( gaps + g ))
  done

  if [ "$porcelain" -eq 1 ]; then
    for (( i = 0; i < ${#names[@]}; i++ )); do
      printf 'reviewer\t%s\t%d\t%d\t%d\t%d\n' \
        "${names[i]}" "${ros[i]}" "${fos[i]}" "${tos[i]}" "${tus[i]}"
    done
  else
    printf '%-10s %8s %9s %9s %11s\n' Name review follow total turnaround
    for (( i = 0; i < ${#names[@]}; i++ )); do
      printf '%-10s %8s %9s %9s %11s\n' "${names[i]}" \
        "$(fmt_duration "${ros[i]}")" "$(fmt_duration "${fos[i]}")" \
        "$(fmt_duration "${tos[i]}")" "$(fmt_duration "${tus[i]}")"
    done
    echo
  fi

  # One pass over the directory for every reviewer's nested spawns, instead of
  # nested()'s one call per reviewer - see nested_by_parent()'s own comment.
  # Each reviewer's rows are then just filtered out of this in-memory result.
  # Reuses the scan computed above rather than re-running _meta_scan().
  local all_nested
  all_nested="$(nested_by_parent "$dir" "$scan")"

  local ro_count=0 ro_nested=0 fo_count=0 fo_nested=0 desc dur phase
  for (( i = 0; i < ${#names[@]}; i++ )); do
    while IFS="$(printf '\t')" read -r desc dur phase; do
      [ -n "$desc" ] || continue
      if [ "$phase" = "read-only" ]; then
        ro_count=$(( ro_count + 1 )); ro_nested=$(( ro_nested + dur ))
      else
        fo_count=$(( fo_count + 1 )); fo_nested=$(( fo_nested + dur ))
      fi
      if [ "$porcelain" -eq 1 ]; then
        printf 'nested\t%s\t%s\t%d\t%s\n' "${names[i]}" "$desc" "$dur" "$phase"
      else
        printf '  nested: %-10s %-34s %-9s %8s\n' \
          "${names[i]}" "$desc" "$phase" "$(fmt_duration "$dur")"
      fi
    done <<EOF
$(printf '%s\n' "$all_nested" | awk -F'\t' -v p="${ids[i]}" -v ft="${fts[i]}" '
  $1 == p {
    phase = "read-only"
    if (ft > 0 && $4 >= ft) phase = "follow"
    print $2 "\t" $3 "\t" phase
  }')
EOF
  done

  for (( i = 1; i < ${#names[@]}; i++ )); do
    g=$(( starts[i] - ends[i-1] ))
    [ "$g" -gt 0 ] || continue
    if [ "$porcelain" -eq 1 ]; then
      printf 'gap\t%s\t%s\t%d\n' "${names[i-1]}" "${names[i]}" "$g"
    fi
  done

  if [ "$porcelain" -eq 1 ]; then
    printf 'totals\t%d\t%d\t%d\t%d\t%d\n' "$sum_ro" "$sum_fo" "$active" "$span" "$gaps"
  else
    local pct=0
    [ "$active" -gt 0 ] && pct=$(( sum_ro * 1000 / active ))
    printf 'read-only  %s (%d.%d%%)\n' "$(fmt_duration "$sum_ro")" $(( pct / 10 )) $(( pct % 10 ))
    printf 'follow     %s\n' "$(fmt_duration "$sum_fo")"
    printf 'active     %s\n' "$(fmt_duration "$active")"
    printf 'span       %s\n' "$(fmt_duration "$span")"
    printf 'gaps       %s across %d\n' "$(fmt_duration "$gaps")" $(( ${#names[@]} - 1 ))
    printf 'nested     read-only %d spawn(s), %s; follow %d spawn(s), %s\n' \
      "$ro_count" "$(fmt_duration "$ro_nested")" \
      "$fo_count" "$(fmt_duration "$fo_nested")"
  fi
}

# Sourced with _WF_CYCLE_TIMINGS_LIB_ONLY=1 (by tests): define functions and
# stop before parsing args or reading a transcript.
if [ -n "${_WF_CYCLE_TIMINGS_LIB_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
