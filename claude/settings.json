{
  "env": {
    "CLAUDE_CODE_IDLE_NOTIFICATION_THRESHOLD_MS": "1000"
  },
  "permissions": {
    "allow": [
      "Bash(bats --version)",
      "Bash(command -v:*)",
      "Bash(dotfiles*)",
      "Bash(gh --version)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(git --version)",
      "Bash(git add:*)",
      "Bash(git config --get init.defaultBranch)",
      "Bash(git config --global --list)",
      "Bash(git config --show-origin --get *)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git help --man *)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git pull:*)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse --local-env-vars)",
      "Bash(git symbolic-ref --short HEAD)",
      "Bash(git worktree add *)",
      "Bash(npm --version)",
      "Bash(npm test *)",
      "Bash(npx vitest run)",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Plane_so__create_page",
      "mcp__claude_ai_Plane_so__create_work_item",
      "mcp__claude_ai_Plane_so__create_work_item_comment",
      "mcp__claude_ai_Plane_so__create_work_item_relation",
      "mcp__claude_ai_Plane_so__get_me",
      "mcp__claude_ai_Plane_so__get_project_estimate",
      "mcp__claude_ai_Plane_so__get_workspace_members",
      "mcp__claude_ai_Plane_so__list_cycle_work_items",
      "mcp__claude_ai_Plane_so__list_cycles",
      "mcp__claude_ai_Plane_so__list_labels",
      "mcp__claude_ai_Plane_so__list_modules",
      "mcp__claude_ai_Plane_so__list_pages",
      "mcp__claude_ai_Plane_so__list_project_estimate_points",
      "mcp__claude_ai_Plane_so__list_projects",
      "mcp__claude_ai_Plane_so__list_states",
      "mcp__claude_ai_Plane_so__list_work_item_comments",
      "mcp__claude_ai_Plane_so__list_work_item_types",
      "mcp__claude_ai_Plane_so__list_work_items",
      "mcp__claude_ai_Plane_so__manage_cycle_work_items",
      "mcp__claude_ai_Plane_so__member",
      "mcp__claude_ai_Plane_so__project",
      "mcp__claude_ai_Plane_so__retrieve_work_item_by_identifier",
      "mcp__claude_ai_Plane_so__search_work_items",
      "mcp__claude_ai_Plane_so__state",
      "mcp__claude_ai_Plane_so__update_project_features",
      "mcp__claude_ai_Plane_so__update_work_item",
      "mcp__claude_ai_Plane_so__workitem",
      "Read(~/.agents/AGENTS.md)",
      "Read(~/.agents/skills/plane-work-item-conventions/CONVENTIONS.md)",
      "Read(~/.claude/**)",
      "Skill(update-config)",
      "WebSearch"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "$HOME/.agents"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.json) jq . \"$f\" > /dev/null ;; *.yml|*.yaml) yamllint \"$f\" ;; *.md) markdownlint-cli2 --config ~/.markdownlint.yml \"$f\" ;; esac; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/block-file-deletions.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/block-force-push.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
