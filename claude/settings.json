{
  "env": {
    "CLAUDE_CODE_IDLE_NOTIFICATION_THRESHOLD_MS": "1000"
  },
  "permissions": {
    "allow": [
      "Bash(bats --version)",
      "Bash(command -v:*)",
      "Bash(dotfiles*)",
      "Bash(gh --version)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(git --version)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git cherry-pick *)",
      "Bash(git commit:*)",
      "Bash(git config --get init.defaultBranch)",
      "Bash(git config --global --list)",
      "Bash(git config --show-origin --get *)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git help --man *)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git pull:*)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse --git-dir --git-common-dir --show-toplevel)",
      "Bash(git rev-parse --is-inside-work-tree)",
      "Bash(git rev-parse --local-env-vars)",
      "Bash(git rev-parse --verify --quiet *)",
      "Bash(git status --porcelain)",
      "Bash(git symbolic-ref --short HEAD)",
      "Bash(git worktree add *)",
      "Bash(npm --version)",
      "Bash(npm test *)",
      "Bash(npx vitest run)",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Plane_so__cycle",
      "mcp__claude_ai_Plane_so__get_pql_reference",
      "mcp__claude_ai_Plane_so__label",
      "mcp__claude_ai_Plane_so__member",
      "mcp__claude_ai_Plane_so__module",
      "mcp__claude_ai_Plane_so__page",
      "mcp__claude_ai_Plane_so__project",
      "mcp__claude_ai_Plane_so__project_estimate",
      "mcp__claude_ai_Plane_so__state",
      "mcp__claude_ai_Plane_so__workitem",
      "mcp__claude_ai_Plane_so__workitem_activity",
      "mcp__claude_ai_Plane_so__workitem_comment",
      "mcp__claude_ai_Plane_so__workitem_link",
      "mcp__claude_ai_Plane_so__workitem_relation",
      "mcp__claude_ai_Plane_so__workitem_type",
      "mcp__home-assistant__ha_config_list_dashboard_resources",
      "mcp__home-assistant__ha_eval_template",
      "mcp__home-assistant__ha_get_logs",
      "mcp__home-assistant__ha_get_overview",
      "mcp__home-assistant__ha_get_state",
      "mcp__home-assistant__ha_list_services",
      "Read(~/.agents/AGENTS.md)",
      "Read(~/.agents/skills/work-item-conventions/CONVENTIONS.md)",
      "Read(~/.agents/skills/work-item-conventions/RESOLUTION.md)",
      "Read(~/.agents/skills/work-item-conventions/references/*.md)",
      "Read(~/.claude/**)",
      "Skill(update-config)",
      "WebSearch"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "$HOME/.agents"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.json) jq . \"$f\" > /dev/null ;; *.yml|*.yaml) yamllint \"$f\" ;; *.md) markdownlint-cli2 --config ~/.markdownlint.yml \"$f\" ;; esac; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/block-file-deletions.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/block-force-push.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
